			"event": [
				{
					"listen": "prerequest",
					"script": {
						"type": "text/javascript",
						"exec": [
							"// Clear cached token to force refresh",
							"pm.collectionVariables.set('token', '');",
							"pm.collectionVariables.set('tokenExpiry', '');",
							"console.log('Token cache cleared. The collection-level pre-request script will fetch a new one.');"
						]
					}
				}
			],
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{token}}",
							"type": "string"
						}
					]
				},
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "CorrelationID",
						"value": "{{correlationId}}"
					},
					{
						"key": "MerchantID",
						"value": "{{merchantId}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"MessageTrxID\": \"{{messageTrxId}}\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{baseUrl}}/A2AMerchantInterface/PaymentInquiry",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"A2AMerchantInterface",
						"PaymentInquiry"
					]
				},
				"description": "Utility request: clears the cached token, then runs an inquiry which triggers the auto-refresh script. Useful for testing the refresh flow."
			},
			"response": []
		}
