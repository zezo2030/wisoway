	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// =====================================================",
					"// Collection-level Pre-Request Script",
					"// 1) Generates a fresh CorrelationID for every request",
					"// 2) Auto-refreshes the bearer token if missing/expired",
					"// =====================================================",
					"",
					"// 1. Always generate a fresh CorrelationID",
					"pm.collectionVariables.set(",
					"    'correlationId',",
					"    'REQ-' + Date.now() + '-' + Math.floor(Math.random() * 100000)",
					");",
					"",
					"// 2. Skip auto-refresh if this IS the GetToken request",
					"if (pm.collectionVariables.get('skipAutoToken') === 'true') {",
					"    console.log('Auto-token refresh skipped (manual GetToken request).');",
					"    return;",
					"}",
					"",
					"const currentToken = pm.collectionVariables.get('token');",
					"const tokenExpiry = pm.collectionVariables.get('tokenExpiry');",
					"const now = Date.now();",
					"const bufferMs = 60 * 1000; // refresh 60s before expiry",
					"",
					"const tokenIsValid = currentToken && tokenExpiry && (parseInt(tokenExpiry) - now > bufferMs);",
					"",
					"if (tokenIsValid) {",
					"    console.log('Using cached token. Expires in', Math.round((parseInt(tokenExpiry) - now) / 1000), 'sec.');",
					"    return;",
					"}",
					"",
					"console.log('Fetching new token...');",
					"",
					"const refreshCorrelationId = 'TKN-' + Date.now() + '-' + Math.floor(Math.random() * 100000);",
					"",
					"pm.sendRequest({",
					"    url: pm.collectionVariables.get('baseUrl') + '/A2AMerchantInterface/GetToken',",
					"    method: 'POST',",
					"    header: {",
					"        'Content-Type': 'application/json',",
					"        'CorrelationID': refreshCorrelationId,",
					"        'MerchantID': pm.collectionVariables.get('merchantId'),",
					"        'UserID': pm.collectionVariables.get('userId'),",
					"        'Password': pm.collectionVariables.get('password')",
					"    },",
					"    body: {",
					"        mode: 'raw',",
					"        raw: JSON.stringify({",
					"            SecurityKey: pm.collectionVariables.get('securityKey')",
					"        })",
					"    }",
					"}, function (err, response) {",
					"    if (err) {",
					"        console.error('Token refresh failed:', err);",
					"        return;",
					"    }",
					"    try {",
					"        const data = response.json();",
					"        if (data && data.TokenInfo && data.TokenInfo.Token) {",
					"            pm.collectionVariables.set('token', data.TokenInfo.Token);",
					"            const expiry = new Date(data.TokenInfo.ExpiryDate).getTime();",
					"            pm.collectionVariables.set('tokenExpiry', expiry.toString());",
					"            console.log('Token refreshed. Expires at:', data.TokenInfo.ExpiryDate);",
					"        } else {",
					"            console.error('Invalid token response:', JSON.stringify(data));",
					"        }",
					"    } catch (e) {",
					"        console.error('Failed to parse token response:', e);",
					"    }",
					"});"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Collection-level test: log the response code for every request",
					"console.log('Response code:', pm.response.code, '|', pm.info.requestName);"
				]
			}
		}
	],
