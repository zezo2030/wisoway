# Wisoway / Rideshare - root compose env
# Copy to .env and adjust.
# Backend secrets (Twilio, JWT, Firebase, etc.) live in rideshare-backend/.env

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rideshare
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Edge nginx
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443

# Dashboard build-time vars (baked into the SPA bundle)
# Leave as relative paths so the dashboard uses whatever host serves it.
VITE_API_BASE_URL=/api
VITE_WS_URL=/
