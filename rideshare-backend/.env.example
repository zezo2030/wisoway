# App
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1
# Optional. Origin baked into freshly uploaded file URLs. Leave empty in dev:
# responses are normalised to the host each client actually used (see
# UploadUrlInterceptor). Set behind a fixed public domain/CDN, e.g.
# SERVER_BASE_URL=https://api.example.com
SERVER_BASE_URL=

# MongoDB
MONGODB_URI=mongodb://localhost:27017/rideshare

# PostgreSQL + PostGIS
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rideshare
POSTGRES_SSL=false

# JWT
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# OTP Provider: 'twilio' (default) or 'local' (for dev - codes logged to console)
OTP_PROVIDER=local

# Twilio (OTP) - required when OTP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your-twilio-api-key-secret
# Optional fallback when using Programmable SMS instead of Verify API
TWILIO_PHONE_NUMBER=+1234567890

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Facebook OAuth
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# AWS S3
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_S3_BUCKET=rideshare-uploads
AWS_REGION=me-south-1

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Firebase (FCM) — ضع نسخة من مفتاح الخدمة في config/firebase-adminsdk.json (غير مرفوع لـ Git)
FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-adminsdk.json
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY=your-private-key
FIREBASE_CLIENT_EMAIL=your-client-email
# Firebase Admin credentials above are also reused for dashboard web push.
FIREBASE_WEB_MESSAGING_SENDER_ID=your-web-messaging-sender-id

# Google Maps (still used for routing/distance; route falls back to OSRM if unset)
GOOGLE_MAPS_API_KEY=your-maps-api-key

# Place autocomplete uses the free OpenStreetMap Nominatim geocoder — no API key
# or billing required. Override the base URL to point at a self-hosted
# Nominatim/Photon mirror to lift the public instance's rate limits.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# Nominatim's usage policy requires an identifiable User-Agent (app name + contact).
NOMINATIM_USER_AGENT=WisowayRideshare/1.0 (+https://wisoway.app)
# Optional: comma-separated ISO country codes to scope place suggestions to
# (e.g. "jo,eg,sa", max 5). Leave empty for global suggestions.
LOCATION_AUTOCOMPLETE_COUNTRIES=
