# Settings for the manual QA harness (rideshare-backend/qa).
# Copy to .env.qa and fill in. .env.qa is gitignored — never commit real values.

# API under test
QA_BASE=http://localhost:3003/api/v1

# Database the harness reads OTP codes from
QA_DB_HOST=localhost
QA_DB_PORT=5433
QA_DB_USER=postgres
QA_DB_PASSWORD=
QA_DB_NAME=rideshare

# Admin account used by 06-admin.js
QA_ADMIN_EMAIL=
QA_ADMIN_PASSWORD=

# Password the harness registers its throwaway driver accounts with
QA_DRIVER_PASSWORD=

# Passenger passwords. PASSWORD and ALT_PASSWORD are the two halves of the
# change-password rotation in 02-profile-vehicles-misc.js; RESET_PASSWORD is
# what the forgot-password flow lands on and what later scripts log in with.
QA_PASSENGER_PASSWORD=
QA_PASSENGER_ALT_PASSWORD=
QA_PASSENGER_RESET_PASSWORD=
